# Postgres connection string (Neon or any Postgres 15+ instance). Dummy value below.
DATABASE_URI=postgresql://user:password@ep-example-000000.us-west-2.aws.neon.tech/suyabuzz?sslmode=require

# Payload's encryption/signing secret. Generate a real one for each environment
# (e.g. `openssl rand -base64 32`) — never reuse this placeholder.
PAYLOAD_SECRET=REPLACE_WITH_A_GENERATED_SECRET

# Public origin the app is served from (no trailing slash).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Shared secret required by scheduled/cron-triggered API routes.
CRON_SECRET=REPLACE_WITH_A_GENERATED_SECRET

# IANA timezone the shop's pickup hours and order cutoffs are computed in.
SHOP_TIMEZONE=America/Los_Angeles

# Optional. Resend API key used to email the owner when the contact form is
# submitted. The form still saves to the database and works without it —
# sendOwnerNotification() just skips the email and logs a warning.
RESEND_API_KEY=re_REPLACE_WITH_A_RESEND_API_KEY

# Optional. Inbox that receives contact-form notifications. Required
# alongside RESEND_API_KEY for the email to actually send.
OWNER_NOTIFICATION_EMAIL=owner@suyabuzz.com

# Absolute path to persistent upload storage (Hostinger only; omit locally)
# MEDIA_DIR=/home/username/domains/suyabuzz.com/media
